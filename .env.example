# Copy to .env for local use, or paste these into Horizon's environment UI.
# .env is gitignored — never commit real values.

# --- Transport -------------------------------------------------------------
# Unset  = stdio (Claude Desktop launches the process directly)
# Set    = Streamable HTTP on HOST:PORT, for remote hosting
# MCP_HTTP=1
# HOST=0.0.0.0
# PORT=8000

# --- Local TLS -------------------------------------------------------------
# Only needed on a network doing TLS inspection with a private root CA, which
# Python's bundled certifi does not trust. Not needed on a cloud host.
# USE_OS_TRUSTSTORE=1

# --- Startup ---------------------------------------------------------------
# Warm the ~5 MB player map at boot instead of on the first request.
#
# SET THIS ON THE DEPLOYED HOST. A managed host is given an entrypoint like
# "server.py:mcp" and imports the module rather than running it as a script,
# so the __main__ block never executes. MCP_WARM is what makes warming fire
# on import, which is the only hook a managed host actually triggers.
#
# Leave it unset locally: it keeps test imports cheap, and stdio launches do
# not want a 5 MB fetch in front of every Claude Desktop restart.
# MCP_WARM=1

# --- League and identity ---------------------------------------------------
SLEEPER_LEAGUE_ID=1312218810614300672
SLEEPER_USERNAME=JarrodLee
SLEEPER_TEAM_NAME=Pine Bluff Escapees
# SLEEPER_SPORT=nfl

# --- Yahoo Fantasy (phase 1: league reads) ---------------------------------
# Create a Yahoo developer app, then run: python tools/yahoo_auth.py
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REFRESH_TOKEN=
# Full token blob alternative to YAHOO_REFRESH_TOKEN (includes access token):
# YAHOO_TOKEN_JSON=
# League key format: {game_key}.l.{league_id} — e.g. 461.l.12345 for NFL 2025
# YAHOO_LEAGUE_KEY=461.l.12345
# YAHOO_TEAM_NAME=My Yahoo Team
# Scoring used for Yahoo start/sit projections (Sleeper proj fields):
# YAHOO_SCORING_FORMAT=ppr
# Auction $ budget for get_auction_budgets(platform="yahoo"); defaults to 200
# YAHOO_AUCTION_BUDGET=200
# YAHOO_TOKEN_CACHE_FILE=/path/to/yahoo_oauth.json

# --- Storage ---------------------------------------------------------------
# Player map (~5 MB) and nflverse CSVs (2-7 MB per season) land here.
# Point this at a writable path on any host with an ephemeral filesystem.
# SLEEPER_CACHE_DIR=/tmp/sleeper-mcp

# Overrides the bundled playcaller_tiers.json.
# SLEEPER_PLAYCALLER_TIERS_FILE=/path/to/playcaller_tiers.json

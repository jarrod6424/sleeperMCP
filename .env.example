# Copy to .env for local use, or paste these into Horizon's environment UI.
# .env is gitignored — never commit real values.

# --- Transport -------------------------------------------------------------
# Unset  = stdio (Claude Desktop launches the process directly)
# Set    = Streamable HTTP on HOST:PORT, for remote hosting
# MCP_HTTP=1
# HOST=0.0.0.0
# PORT=8000

# --- Local TLS -------------------------------------------------------------
# Only needed on a network doing TLS inspection with a private root CA, which
# Python's bundled certifi does not trust. Not needed on a cloud host.
# USE_OS_TRUSTSTORE=1

# --- Startup ---------------------------------------------------------------
# Warm the ~5 MB player map at boot instead of on the first request.
# Automatic under MCP_HTTP. Opt-in for stdio, where Claude Desktop restarts
# the process often and this would sit in front of every launch.
# MCP_WARM=1

# --- League and identity ---------------------------------------------------
SLEEPER_LEAGUE_ID=1312218810614300672
SLEEPER_USERNAME=JarrodLee
SLEEPER_TEAM_NAME=Pine Bluff Escapees
# SLEEPER_SPORT=nfl

# --- Storage ---------------------------------------------------------------
# Player map (~5 MB) and nflverse CSVs (2-7 MB per season) land here.
# Point this at a writable path on any host with an ephemeral filesystem.
# SLEEPER_CACHE_DIR=/tmp/sleeper-mcp

# Overrides the bundled oc_tiers.json.
# SLEEPER_OC_TIERS_FILE=/path/to/oc_tiers.json
